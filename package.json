{
  "name": "thuypd-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace Monorepo for THUYPD.SITE ecosystem",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --prefix api.thuypd.site",
    "dev:client": "npm run dev --prefix thuypd.site",
    "dev:admin": "npm run dev --prefix admin.thuypd.site",
    "docker:up": "docker compose --env-file .env.docker up -d",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:build": "docker compose --env-file .env.docker build",
    "docker:logs": "docker compose --env-file .env.docker logs -f",
    "docker:restart": "docker compose --env-file .env.docker restart",
    "install:all": "npm install --prefix api.thuypd.site && npm install --prefix thuypd.site && npm install --prefix admin.thuypd.site",
    "build:all": "npm run build --prefix api.thuypd.site && npm run build --prefix thuypd.site && npm run build --prefix admin.thuypd.site"
  }
}
