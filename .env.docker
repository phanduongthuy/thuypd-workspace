# ==============================================================================
# THUYPD.SITE Ecosystem — Docker Compose Environment (.env.docker)
# ==============================================================================

# Ports on Host Machine
HOST_PORT_CLIENT=3010
HOST_PORT_ADMIN=3002
HOST_PORT_API=5001
HOST_PORT_MONGO=27017

# Internal URLs inside Docker Network (service names)
INTERNAL_API_URL=http://api:5000
INTERNAL_DATABASE_URI=mongodb://mongodb:27017/thuypd_site

# Host-Accessible URLs (used by browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:5001

# Security & Default Admin
JWT_SECRET=docker_secure_jwt_secret_thuypd_2026
JWT_EXPIRES_IN=7d
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=admin123
ADMIN_DEFAULT_EMAIL=admin@thuypd.local
CLIENT_ORIGINS=http://localhost:3010,http://localhost:3002,http://localhost:3000
